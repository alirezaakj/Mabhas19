<?xml version="1.0" encoding="utf-8"?>
<!--
  The Phase 1 guest database stays on this device only: no cloud backup and no device transfer
  until account/session and export policy are defined. See docs/android/architecture.md.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
